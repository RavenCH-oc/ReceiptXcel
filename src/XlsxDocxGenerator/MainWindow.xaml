<Window x:Class="XlsxDocxGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReceiptXcel｜自行收納款項收據產生工具"
        Height="820"
        Width="1000"
        MinHeight="700"
        MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Loaded="Window_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="ReceiptXcel" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="自行收納款項收據產生工具" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <Border Grid.Row="1"
                    Background="#EAEAEE"
                    CornerRadius="10"
                    Padding="4"
                    Margin="0,0,0,24"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="產生文件"
                                 GroupName="MainMode"
                                 IsChecked="{Binding IsGenerateDocumentsMode, Mode=OneWay}"
                                 Click="GenerateMode_Click"
                                 Style="{StaticResource SegmentButtonStyle}" />
                    <RadioButton Content="建立模板"
                                 GroupName="MainMode"
                                 IsChecked="{Binding IsCreateTemplateMode, Mode=OneWay}"
                                 Click="CreateMode_Click"
                                 Style="{StaticResource SegmentButtonStyle}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid Visibility="{Binding IsGenerateDocumentsMode, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="模板" Style="{StaticResource SectionTitleStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding TemplateDisplayName}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding WordTemplateFileName}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,0" />
                                        <TextBlock Text="{Binding TemplateFieldCountText, StringFormat=欄位：{0}}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="載入模板" Click="LoadTemplate_Click" Margin="12,0,8,0" />
                                    <Button Grid.Column="2" Content="建立新模板" Click="CreateMode_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Excel 資料" Style="{StaticResource SectionTitleStyle}" />
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding ExcelPath, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="選擇 Excel" Click="SelectExcel_Click" Margin="12,0,0,0" />
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="檔案" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding ExcelFileName}" VerticalAlignment="Center" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="工作表" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding WorksheetNames}" SelectedItem="{Binding SelectedWorksheet}" />
                                </Grid>
                                <TextBlock Text="{Binding ExcelFormatStatusText}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,14,0,0" />

                                <Expander Header="進階選項" Margin="0,18,0,0">
                                    <StackPanel Margin="0,12,0,0">
                                        <TextBlock Text="目前 Excel 欄位對應列（可選）" ToolTip="若 Excel 仍保留欄位對應列，可在這裡指定列號。" />
                                        <TextBox Text="{Binding RuntimeMarkerRowText, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding RuntimeMarkerInstructionText}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="資料選擇" Style="{StaticResource SectionTitleStyle}" />
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="模式" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding SelectionModes}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedMode}" />
                                </Grid>
                                <Grid Visibility="{Binding IsMarkerMode, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="標記欄位" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding SelectionMarkerColumns}" SelectedItem="{Binding SelectedMarkerColumn}" Margin="0,0,16,0" ToolTip="選擇 Excel 中用來篩選資料的欄位。" />
                                    <TextBlock Grid.Column="2" Text="標記代號" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="3" Text="{Binding MarkerTokensText, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如：A 或 A,B" />
                                </Grid>
                                <Grid Visibility="{Binding IsExcelRowsMode, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="列號" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding RowExpressionText, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如：5,8,10-15" />
                                </Grid>
                                <Grid Visibility="{Binding IsLatestMode, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="最新筆數" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding LatestCountText, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Border Background="#F5F5F7" CornerRadius="8" Padding="12" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding SelectionSummaryText}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="輸出" Style="{StaticResource SectionTitleStyle}" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="輸出資料夾" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="2" Content="選擇" Click="SelectOutputDirectory_Click" Margin="12,0,8,0" />
                                    <Button Grid.Column="3" Content="開啟" Click="OpenOutputDirectory_Click" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="輸出檔名" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBlock Text="可使用 {{ID}}、{{NAME}} 等欄位代號" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,4,8,0" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding OutputPattern, UpdateSourceTrigger=PropertyChanged}" ToolTip="可使用 {{ID}}、{{NAME}} 等欄位代號。" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Padding="20,18">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectionSummaryText}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="產生 Word" Style="{StaticResource PrimaryButtonStyle}" Height="48" FontSize="18" IsEnabled="{Binding CanGenerateBatch}" Click="GenerateWord_Click" />
                                    <Button Grid.Column="1" Content="取消" Style="{StaticResource CancelButtonStyle}" Height="48" IsEnabled="{Binding CanCancelBatch}" Click="CancelBatch_Click" Margin="12,0,0,0" />
                                </Grid>
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar Grid.Column="0" Maximum="{Binding ProgressMaximum, Mode=OneWay}" Value="{Binding ProgressValue, Mode=OneWay}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding ProgressText, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}" Margin="14,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="結果" Style="{StaticResource SectionTitleStyle}" />
                                <ListView ItemsSource="{Binding BatchResults}" MaxHeight="220">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="" DisplayMemberBinding="{Binding StatusIcon}" Width="32" />
                                            <GridViewColumn Header="資料列" DisplayMemberBinding="{Binding RowText}" Width="110" />
                                            <GridViewColumn Header="結果" DisplayMemberBinding="{Binding Detail}" Width="620" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <TextBlock Text="{Binding StatusText, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Visibility="{Binding IsCreateTemplateMode, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="1. 選擇 Excel 範例" Style="{StaticResource SectionTitleStyle}" />
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding ExcelPath, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="選擇 Excel" Click="SelectExcel_Click" Margin="12,0,0,0" />
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="工作表" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding WorksheetNames}" SelectedItem="{Binding SelectedWorksheet}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="標題列" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding HeaderRowText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="2" Text="欄位對應列" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="20,0,0,0" ToolTip="在 Excel 中輸入 {{ID}}、{{NAME}} 等欄位代號。" />
                                    <TextBox Grid.Column="3" Text="{Binding MarkerRowText, UpdateSourceTrigger=PropertyChanged}" ToolTip="欄位對應列的 Excel 列號；留白時會自動尋找。" />
                                </Grid>
                                <TextBlock Text="請在 Excel 的欄位對應列輸入 {{ID}}、{{NAME}}、{{DATE}} 等欄位代號。" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="2. 選擇 Word 範例" Style="{StaticResource SectionTitleStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding WordTemplatePath, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="選擇 Word" Click="SelectWordTemplate_Click" Margin="12,0,0,0" />
                                </Grid>
                                <TextBlock Text="{Binding WordTemplateFileName}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,12,0,0" />
                                <TextBlock Text="在 Word 中使用與 Excel 相同的欄位代號，例如 {{NAME}}。支援正文、表格、頁首與頁尾。" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="3. 讀取欄位" Style="{StaticResource SectionTitleStyle}" />
                                    <Button Grid.Column="1" Content="讀取欄位" Click="ReadMapping_Click" />
                                </Grid>
                                <ListView ItemsSource="{Binding MappingPreview}" MaxHeight="190">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="欄位代號" DisplayMemberBinding="{Binding Placeholder}" Width="250" />
                                            <GridViewColumn Header="Excel 欄位" DisplayMemberBinding="{Binding ExcelColumn}" Width="500" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="4. 模板資訊" Style="{StaticResource SectionTitleStyle}" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="模板名稱" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="輸出檔名" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding OutputPattern, UpdateSourceTrigger=PropertyChanged}" ToolTip="可使用 {{ROW}}、{{ID}}、{{NAME}} 等欄位代號。" />
                                </Grid>
                                <TextBlock Text="輸出檔名可使用 {{ROW}}、{{ID}}、{{NAME}} 等欄位代號。" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="120,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Padding="20,18">
                            <StackPanel>
                                <Button Content="建立並儲存模板" Style="{StaticResource PrimaryButtonStyle}" Height="48" FontSize="18" Click="CreateTemplate_Click" />
                                <TextBlock Text="{Binding StatusText, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,14,0,0" />
                                <Button Content="使用此模板產生文件" Click="UseTemplate_Click" IsEnabled="{Binding HasTemplate}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
