<Window x:Class="XlsxDocxGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReceiptXcel｜自行收納款項收據產生工具"
        Height="850"
        Width="980"
        MinHeight="700"
        MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Loaded="Window_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,22">
                <TextBlock Text="ReceiptXcel" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="自行收納款項收據產生工具" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Excel 資料" Style="{StaticResource SectionTitleStyle}" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Excel 收據登記表" VerticalAlignment="Center" Margin="0,0,18,0" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding ExcelPath, Mode=OneWay}"
                                 IsReadOnly="True"
                                 ToolTip="請選擇 .xlsx 檔案。" />
                        <Button Grid.Column="2" Content="選擇" Click="SelectExcel_Click" Margin="12,0,0,0" IsEnabled="{Binding CanEditInputs}" />
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="工作表" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding WorksheetNames}"
                                  SelectedItem="{Binding SelectedWorksheet}"
                                  IsEnabled="{Binding CanEditInputs}" />
                    </Grid>
                    <TextBlock Text="{Binding ExcelFormatStatusText}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding InternalTemplateStatusText}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="資料選擇" Style="{StaticResource SectionTitleStyle}" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="選擇方式" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding SelectionModes}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedMode}"
                                  IsEnabled="{Binding CanEditInputs}" />
                    </Grid>
                    <Grid Visibility="{Binding IsLatestMode, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="最新筆數" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding LatestCountText, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEditInputs}" />
                    </Grid>
                    <Grid Visibility="{Binding IsExcelRowsMode, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Excel 列號" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding RowExpressionText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="例如：3、3,5,8、3-6、3,5,8-10"
                                 IsEnabled="{Binding CanEditInputs}" />
                    </Grid>
                    <Border Background="#F5F5F7" CornerRadius="8" Padding="14">
                        <TextBlock Text="{Binding SelectionSummaryText}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="輸出" Style="{StaticResource SectionTitleStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="輸出資料夾" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True" />
                        <Button Grid.Column="2" Content="選擇" Click="SelectOutputDirectory_Click" Margin="12,0,8,0" IsEnabled="{Binding CanEditInputs}" />
                        <Button Grid.Column="3" Content="開啟" Click="OpenOutputDirectory_Click" IsEnabled="{Binding CanEditInputs}" />
                    </Grid>
                    <TextBlock Text="每筆收據會使用固定檔名；不會覆寫既有檔案。"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="20,18">
                <StackPanel>
                    <TextBlock Text="{Binding SelectionSummaryText}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="產生收據"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="48"
                                FontSize="18"
                                IsEnabled="{Binding CanGenerate}"
                                Click="GenerateReceipt_Click" />
                        <Button Grid.Column="1"
                                Content="取消"
                                Style="{StaticResource CancelButtonStyle}"
                                Height="48"
                                IsEnabled="{Binding CanCancel}"
                                Click="CancelBatch_Click"
                                Margin="12,0,0,0" />
                    </Grid>
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0"
                                     Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                                     Value="{Binding ProgressValue, Mode=OneWay}"
                                     VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ProgressText, Mode=OneWay}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="5" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="結果" Style="{StaticResource SectionTitleStyle}" />
                    <ListView ItemsSource="{Binding BatchResults}" MaxHeight="250">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="" DisplayMemberBinding="{Binding StatusIcon}" Width="32" />
                                <GridViewColumn Header="資料列" DisplayMemberBinding="{Binding RowText}" Width="110" />
                                <GridViewColumn Header="收據編號" DisplayMemberBinding="{Binding ReceiptText}" Width="130" />
                                <GridViewColumn Header="結果" DisplayMemberBinding="{Binding Detail}" Width="580" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
